PORT=3001

# Вход администратора — один на все посты, через интерфейс его создать нельзя.
# Строки получаются командой `npm run admin` на уже настроенном посту
# или `npm run admin -- set-password` (спросит пароль и запишет их сюда сам).
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=

# Название учреждения — печатается заголовком на чеке перед пропуском.
# Обычно оставляют пустым: администратор вводит его при первом входе на пост
# («Справочники» → «Учреждение»), значение из интерфейса важнее этого.
INSTITUTION_NAME=

# Термопринтер (ESC/POS).
# Примеры PRINTER_INTERFACE:
#   printer:ИмяПринтера            — USB-принтер, установленный в Windows
#                                    (см. точное имя: Get-Printer в PowerShell
#                                    или Панель управления → Устройства и принтеры)
#   tcp://192.168.1.100:9100      — сетевой принтер (порт обычно 9100)
PRINTER_TYPE=EPSON
PRINTER_INTERFACE=printer:XP-80C
PRINTER_WIDTH=42
# Кодировка важна для корректной печати кириллицы на конкретной модели принтера
PRINTER_CHARACTER_SET=PC866_CYRILLIC2

# Сканер QR в режиме USB COM (виртуальный последовательный порт). В этом режиме
# сканер не вводит символы как клавиатура и не мешает дежурному печатать.
#   auto — найти USB COM-порт сканера автоматически (по умолчанию)
#   COM5 — конкретный порт (Диспетчер устройств → Порты (COM и LPT))
#   off  — не читать порт (сканер в режиме клавиатуры)
SCANNER_PORT=auto
SCANNER_BAUD_RATE=9600
